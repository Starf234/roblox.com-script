local function updateToggleIndicator(indicator, active)
    if active then
        indicator.BackgroundColor3 = Color3.fromRGB(0, 100, 255)
        indicator.BorderColor3 = Color3.fromRGB(0, 140, 255)
    else
        indicator.BackgroundColor3 = Color3.fromRGB(35, 35, 35)
        indicator.BorderColor3 = Color3.fromRGB(70, 70, 70)
    end
end

-- Player Stats

local function getHumanoid()
    local character = LocalPlayer.Character
    if not character then return nil end
    return character:FindFirstChildOfClass("Humanoid")
end

----------------------------------------------------------------
-- WEIGHT SYSTEM
----------------------------------------------------------------

local function getCharacterParts()
    local character = LocalPlayer.Character
    if not character then
        return {}
    end

    local parts = {}

    for _, object in ipairs(character:GetDescendants()) do
        if object:IsA("BasePart") then
            table.insert(parts, object)
        end
    end

    return parts
end

local function saveOriginalPhysicalProperties(part)
    if not part then return end
    if originalPhysicalProperties[part] ~= nil then return end

    local success, properties = pcall(function()
        return part.CustomPhysicalProperties
    end)

    if success then
        originalPhysicalProperties[part] = properties
    end
end

local function restoreOriginalWeight()
    for part, properties in pairs(originalPhysicalProperties) do
        if part and part.Parent then
            pcall(function()
                part.CustomPhysicalProperties = properties
            end)
        end
    end

    table.clear(originalPhysicalProperties)
end

local function calculateCharacterVolume(parts)
    local totalVolume = 0

    for _, part in ipairs(parts) do
        if part and part:IsA("BasePart") then
            local size = part.Size

            local volume =
                math.abs(size.X) *
                math.abs(size.Y) *
                math.abs(size.Z)

            totalVolume += volume
        end
    end

    return totalVolume
end

local function getCurrentCharacterMass()
    local character = LocalPlayer.Character
    if not character then
        return 0
    end

    local root = character:FindFirstChild("HumanoidRootPart")

    if root then
        local success, mass = pcall(function()
            return root.AssemblyMass
        end)

        if success and mass then
            return mass
        end
    end

    return 0
end

local function applyCharacterWeight(targetWeight)
    if not Session.Active then return false end

    local character = LocalPlayer.Character
    if not character then return false end

    targetWeight = tonumber(targetWeight)

    if not targetWeight or targetWeight <= 0 then
        return false
    end

    local parts = getCharacterParts()

    if #parts == 0 then
        return false
    end

    for _, part in ipairs(parts) do
        saveOriginalPhysicalProperties(part)
    end

    local totalVolume = calculateCharacterVolume(parts)

    if totalVolume <= 0 then
        return false
    end

    -- Approximate density required to reach the requested mass.
    local density = targetWeight / totalVolume

    density = math.clamp(
        density,
        MIN_DENSITY,
        MAX_DENSITY
    )

    for _, part in ipairs(parts) do
        local oldProperties =
            originalPhysicalProperties[part]

        local friction = 0.3
        local elasticity = 0.5
        local frictionWeight = 100
        local elasticityWeight = 100

        if oldProperties then
            pcall(function()
                friction = oldProperties.Friction
                elasticity = oldProperties.Elasticity
                frictionWeight = oldProperties.FrictionWeight
                elasticityWeight = oldProperties.ElasticityWeight
            end)
        end

        local newProperties = PhysicalProperties.new(
            density,
            friction,
            elasticity,
            frictionWeight,
            elasticityWeight
        )

        pcall(function()
            part.CustomPhysicalProperties = newProperties
        end)
    end

    Session.WeightEnabled = true

    savedSettings.Weight = targetWeight
    saveSettings()

    return true
end

local function removeCharacterWeight()
    Session.WeightEnabled = false
    restoreOriginalWeight()
end

local function refreshCharacterWeight()
    if not Session.WeightEnabled then
        return
    end

    local targetWeight =
        tonumber(WeightBox.Text)
        or tonumber(savedSettings.Weight)
        or DEFAULT_WEIGHT

    -- Restore old values first so a respawn/update does not
    -- compound physical-property changes.
    restoreOriginalWeight()

    applyCharacterWeight(targetWeight)
end

----------------------------------------------------------------
-- APPLY PLAYER STATS
----------------------------------------------------------------

local function applyStats()
    if not Session.Active then return end

    local humanoid = getHumanoid()

    local speed = tonumber(WalkSpeedBox.Text)
    local jump = tonumber(JumpPowerBox.Text)
    local gravity = tonumber(GravityBox.Text)
    local flySpeed = tonumber(FlySpeedBox.Text)
    local weight = tonumber(WeightBox.Text)

    if speed then
        savedSettings.WalkSpeed = speed

        if humanoid then
            humanoid.WalkSpeed = speed
        end
    end

    if jump then
        savedSettings.JumpPower = jump

        if humanoid then
            humanoid.UseJumpPower = true
            humanoid.JumpPower = jump
        end
    end

    if gravity then
        savedSettings.Gravity = gravity
        workspace.Gravity = gravity
    end

    if flySpeed and flySpeed >= 0 then
        savedSettings.FlySpeed = flySpeed
    end

    if weight and weight > 0 then
        savedSettings.Weight = weight
        applyCharacterWeight(weight)
    end

    saveSettings()
end

connect(ApplyStatsButton.MouseButton1Click, applyStats)

connect(ResetStatsButton.MouseButton1Click, function()
    WalkSpeedBox.Text = tostring(DEFAULT_WALKSPEED)
    JumpPowerBox.Text = tostring(DEFAULT_JUMPPOWER)
    GravityBox.Text = tostring(DEFAULT_GRAVITY)
    FlySpeedBox.Text = tostring(DEFAULT_FLY_SPEED)
    WeightBox.Text = tostring(DEFAULT_WEIGHT)

    removeCharacterWeight()
    applyStats()
end)

connect(WalkSpeedBox.FocusLost, function()
    local value = tonumber(WalkSpeedBox.Text)

    if value then
        savedSettings.WalkSpeed = value
        saveSettings()
    end
end)

connect(JumpPowerBox.FocusLost, function()
    local value = tonumber(JumpPowerBox.Text)

    if value then
        savedSettings.JumpPower = value
        saveSettings()
    end
end)

connect(GravityBox.FocusLost, function()
    local value = tonumber(GravityBox.Text)

    if value then
        savedSettings.Gravity = value
        saveSettings()
    end
end)

connect(FlySpeedBox.FocusLost, function()
    local value = tonumber(FlySpeedBox.Text)

    if value and value >= 0 then
        savedSettings.FlySpeed = value
        saveSettings()
    end
end)

connect(WeightBox.FocusLost, function()
    local value = tonumber(WeightBox.Text)

    if value and value > 0 then
        savedSettings.Weight = value
        saveSettings()

        if Session.WeightEnabled then
            applyCharacterWeight(value)
        end
    end
end)

-- Fly

local function removeFlyObjects()
    if flyVelocity then
        pcall(function()
            flyVelocity:Destroy()
        end)

        flyVelocity = nil
    end

    if flyGyro then
        pcall(function()
            flyGyro:Destroy()
        end)

        flyGyro = nil
    end

    local character = LocalPlayer.Character

    if character then
        for _, object in ipairs(character:GetDescendants()) do
            if object.Name == "DenosWareFlyVelocity"
                or object.Name == "DenosWareFlyGyro" then

                pcall(function()
                    object:Destroy()
                end)
            end
        end
    end
end

local function stopFly()
    Session.Fly = false
    removeFlyObjects()
    updateToggleIndicator(FlyIndicator, false)

    local humanoid = getHumanoid()

    if humanoid then
        humanoid.PlatformStand = false
    end
end

local function startFly()
    if not Session.Active or Session.Fly then return end

    local character = LocalPlayer.Character
    if not character then return end

    local root = character:FindFirstChild("HumanoidRootPart")
    if not root then return end

    Session.Fly = true
    updateToggleIndicator(FlyIndicator, true)

    flyVelocity = Instance.new("BodyVelocity")
    flyVelocity.Name = "DenosWareFlyVelocity"
    flyVelocity.MaxForce = Vector3.new(math.huge, math.huge, math.huge)
    flyVelocity.Velocity = Vector3.zero
    flyVelocity.Parent = root

    flyGyro = Instance.new("BodyGyro")
    flyGyro.Name = "DenosWareFlyGyro"
    flyGyro.MaxTorque = Vector3.new(math.huge, math.huge, math.huge)
    flyGyro.P = 9000
    flyGyro.D = 500
    flyGyro.Parent = root

    local connection

    connection = RunService.RenderStepped:Connect(function()
        if not Session.Active or not Session.Fly then
            connection:Disconnect()
            return
        end

        if not root.Parent or not flyVelocity or not flyGyro then
            stopFly()
            return
        end

        local camera = workspace.CurrentCamera
        if not camera then return end

        local direction = Vector3.zero

        if UserInputService:IsKeyDown(Enum.KeyCode.W) then
            direction += camera.CFrame.LookVector
        end

        if UserInputService:IsKeyDown(Enum.KeyCode.S) then
            direction -= camera.CFrame.LookVector
        end

        if UserInputService:IsKeyDown(Enum.KeyCode.A) then
            direction -= camera.CFrame.RightVector
        end

        if UserInputService:IsKeyDown(Enum.KeyCode.D) then
            direction += camera.CFrame.RightVector
        end

        if UserInputService:IsKeyDown(Enum.KeyCode.Space) then
            direction += Vector3.new(0, 1, 0)
        end

        if UserInputService:IsKeyDown(Enum.KeyCode.LeftControl) then
            direction -= Vector3.new(0, 1, 0)
        end

        if direction.Magnitude > 0 then
            direction = direction.Unit
        end

        local flySpeed =
            tonumber(FlySpeedBox.Text)
            or DEFAULT_FLY_SPEED

        flyVelocity.Velocity = direction * flySpeed
        flyGyro.CFrame = camera.CFrame
    end)

    table.insert(Session.Connections, connection)
end

connect(FlyRow.MouseButton1Click, function()
    if Session.Fly then
        stopFly()
    else
        startFly()
    end
end)

-- Noclip

local function applyNoclip()
    local character = LocalPlayer.Character
    if not character then return end

    for _, object in ipairs(character:GetDescendants()) do
        if object:IsA("BasePart") then
            object.CanCollide = false
        end
    end
end

local function stopNoclip()
    Session.Noclip = false
    updateToggleIndicator(NoclipIndicator, false)

    local character = LocalPlayer.Character

    if character then
        for _, object in ipairs(character:GetDescendants()) do
            if object:IsA("BasePart") then
                object.CanCollide = true
            end
        end
    end
end

local function startNoclip()
    if not Session.Active or Session.Noclip then return end

    Session.Noclip = true
    updateToggleIndicator(NoclipIndicator, true)

    local connection = RunService.Stepped:Connect(function()
        if Session.Active and Session.Noclip then
            applyNoclip()
        end
    end)

    table.insert(Session.Connections, connection)
end

connect(NoclipRow.MouseButton1Click, function()
    if Session.Noclip then
        stopNoclip()
    else
        startNoclip()
    end
end)

-- Anti Void

local function getAntiVoidY()
    local value = tonumber(AntiVoidYBox.Text)

    if value then
        antiVoidY = value
        savedSettings.AntiVoidY = value
        saveSettings()
    end

    return antiVoidY
end

local function createAntiVoidPart()
    if antiVoidPart and antiVoidPart.Parent then return end

    antiVoidPart = Instance.new("Part")
    antiVoidPart.Name = "DenosWareAntiVoid"
    antiVoidPart.Size = Vector3.new(2048, 1, 2048)
    antiVoidPart.Anchored = true
    antiVoidPart.CanCollide = true
    antiVoidPart.Transparency = 1
    antiVoidPart.CastShadow = false

    antiVoidPart.Position = Vector3.new(
        0,
        getAntiVoidY() - 0.5,
        0
    )

    antiVoidPart.Parent = workspace
end

local function updateAntiVoidPart()
    if not antiVoidPart or not antiVoidPart.Parent then return end

    antiVoidPart.Position = Vector3.new(
        0,
        getAntiVoidY() - 0.5,
        0
    )
end

local function removeAntiVoidPart()
    if antiVoidPart then
        pcall(function()
            antiVoidPart:Destroy()
        end)

        antiVoidPart = nil
    end
end

local function stopAntiVoid()
    Session.AntiVoid = false
    updateToggleIndicator(AntiVoidIndicator, false)
    removeAntiVoidPart()
end

local function startAntiVoid()
    if not Session.Active or Session.AntiVoid then return end

    getAntiVoidY()

    Session.AntiVoid = true
    updateToggleIndicator(AntiVoidIndicator, true)

    createAntiVoidPart()
    updateAntiVoidPart()
end

connect(AntiVoidRow.MouseButton1Click, function()
    if Session.AntiVoid then
        stopAntiVoid()
    else
        startAntiVoid()
    end
end)

connect(AntiVoidYBox.FocusLost, function()
    local value = tonumber(AntiVoidYBox.Text)

    if value then
        antiVoidY = value
        savedSettings.AntiVoidY = value
        AntiVoidYBox.Text = tostring(value)

        saveSettings()

        if Session.AntiVoid then
            updateAntiVoidPart()
        end
    else
        AntiVoidYBox.Text = tostring(antiVoidY)
    end
end)

connect(RunService.Heartbeat, function()
    if not Session.Active or not Session.AntiVoid then return end

    local character = LocalPlayer.Character
    if not character then return end

    local root = character:FindFirstChild("HumanoidRootPart")
    if not root then return end

    local humanoid = character:FindFirstChildOfClass("Humanoid")
    if not humanoid then return end

    local currentY = getAntiVoidY()

    updateAntiVoidPart()

    if root.Position.Y <= currentY then
        local offset = humanoid.HipHeight + 2

        root.CFrame = CFrame.new(
            root.Position.X,
            currentY + offset,
            root.Position.Z
        )

        root.AssemblyLinearVelocity = Vector3.new(
            root.AssemblyLinearVelocity.X,
            0,
            root.AssemblyLinearVelocity.Z
        )

        root.AssemblyAngularVelocity = Vector3.zero
    end
end)

-- Y Axis Limit

local function createYAxisLimitPart()
    if yAxisLimitPart and yAxisLimitPart.Parent then return end
    if not yAxisLimitHeight then return end

    yAxisLimitPart = Instance.new("Part")
    yAxisLimitPart.Name = "DenosWareYAxisLimit"
    yAxisLimitPart.Size = Vector3.new(2048, 1, 2048)
    yAxisLimitPart.Anchored = true
    yAxisLimitPart.CanCollide = true
    yAxisLimitPart.Transparency = 1
    yAxisLimitPart.CastShadow = false

    yAxisLimitPart.Position = Vector3.new(
        0,
        yAxisLimitHeight - 0.5,
        0
    )

    yAxisLimitPart.Parent = workspace
end

local function removeYAxisLimitPart()
    if yAxisLimitPart then
        pcall(function()
            yAxisLimitPart:Destroy()
        end)

        yAxisLimitPart = nil
    end
end

local function updateYAxisLimitDisplay()
    if yAxisLimitHeight then
        YAxisHeightLabel.Text =
            "Current limit: Y = " ..
            string.format("%.1f", yAxisLimitHeight) ..
            " (5 studs below torso)"
    else
        YAxisHeightLabel.Text = "Current limit: OFF"
    end
end

local function stopYAxisLimit()
    Session.YAxisLimit = false

    updateToggleIndicator(
        YAxisLimitIndicator,
        false
    )

    removeYAxisLimitPart()

    yAxisLimitHeight = nil

    updateYAxisLimitDisplay()
end

local function startYAxisLimit()
    if not Session.Active or Session.YAxisLimit then
        return
    end

    local character = LocalPlayer.Character
    if not character then return end

    local root = character:FindFirstChild("HumanoidRootPart")
    if not root then return end

    yAxisLimitHeight = root.Position.Y - Y_AXIS_OFFSET

    Session.YAxisLimit = true

    updateToggleIndicator(
        YAxisLimitIndicator,
        true
    )

    createYAxisLimitPart()
    updateYAxisLimitDisplay()
end

connect(YAxisLimitRow.MouseButton1Click, function()
    if Session.YAxisLimit then
        stopYAxisLimit()
    else
        startYAxisLimit()
    end
end)

connect(RunService.Heartbeat, function()
    if not Session.Active or not Session.YAxisLimit then
        return
    end

    local character = LocalPlayer.Character
    if not character then return end

    local root = character:FindFirstChild("HumanoidRootPart")
    if not root then return end

    if not yAxisLimitHeight then
        return
    end

    if not yAxisLimitPart or not yAxisLimitPart.Parent then
        createYAxisLimitPart()
    end

    if root.Position.Y <= yAxisLimitHeight then
        root.CFrame = CFrame.new(
            root.Position.X,
            yAxisLimitHeight + Y_AXIS_OFFSET,
            root.Position.Z
        )

        root.AssemblyLinearVelocity = Vector3.new(
            root.AssemblyLinearVelocity.X,
            0,
            root.AssemblyLinearVelocity.Z
        )

        root.AssemblyAngularVelocity = Vector3.zero
    end
end)

-- Outline All Players

local function removePlayerOutline(character)
    if not character then return end

    local highlight =
        character:FindFirstChild("DenosWarePlayerOutline")

    if highlight then
        pcall(function()
            highlight:Destroy()
        end)
    end
end

local function addPlayerOutline(character)
    if not character then return end
    if character == LocalPlayer.Character then return end
    if not character.Parent then return end

    local highlight =
        character:FindFirstChild("DenosWarePlayerOutline")

    if not highlight then
        highlight = Instance.new("Highlight")
        highlight.Name = "DenosWarePlayerOutline"
        highlight.Adornee = character
        highlight.Parent = character
    end

    highlight.FillTransparency = 1
    highlight.OutlineTransparency = 0
    highlight.OutlineColor = Color3.fromRGB(255, 255, 255)
    highlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
end

local function updatePlayerOutlines()
    if not Session.Active or not Session.OutlinePlayers then return end

    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= LocalPlayer and player.Character then
            addPlayerOutline(player.Character)
        end
    end
end

local function removeAllPlayerOutlines()
    for _, player in ipairs(Players:GetPlayers()) do
        if player.Character then
            removePlayerOutline(player.Character)
        end
    end
end

local function stopPlayerOutlines()
    Session.OutlinePlayers = false

    updateToggleIndicator(
        OutlinePlayersIndicator,
        false
    )

    removeAllPlayerOutlines()
end

local function startPlayerOutlines()
    if not Session.Active or Session.OutlinePlayers then return end

    Session.OutlinePlayers = true

    updateToggleIndicator(
        OutlinePlayersIndicator,
        true
    )

    updatePlayerOutlines()
end

connect(OutlinePlayersRow.MouseButton1Click, function()
    if Session.OutlinePlayers then
        stopPlayerOutlines()
    else
        startPlayerOutlines()
    end
end)

-- Character Added

connect(LocalPlayer.CharacterAdded, function(character)
    if not Session.Active then return end

    task.wait(0.5)

    if not Session.Active then return end

    local humanoid =
        character:FindFirstChildOfClass("Humanoid")

    if humanoid then
        local speed = tonumber(WalkSpeedBox.Text)
        local jump = tonumber(JumpPowerBox.Text)

        if speed then
            humanoid.WalkSpeed = speed
        end

        if jump then
            humanoid.UseJumpPower = true
            humanoid.JumpPower = jump
        end
    end

    if Session.Noclip then
        applyNoclip()
    end

    if Session.Fly then
        stopFly()

        task.wait(0.1)

        if Session.Active then
            startFly()
        end
    end

    if Session.AntiVoid then
        createAntiVoidPart()
        updateAntiVoidPart()
    end

    if Session.YAxisLimit then
        createYAxisLimitPart()
        updateYAxisLimitDisplay()
    end

    if Session.WeightEnabled then
        task.wait(0.1)

        if Session.Active then
            local weight =
                tonumber(WeightBox.Text)
                or tonumber(savedSettings.Weight)
                or DEFAULT_WEIGHT

            applyCharacterWeight(weight)
        end
    end
end)

connect(Players.PlayerAdded, function(player)
    if not Session.Active then return end

    connect(player.CharacterAdded, function(character)
        if not Session.Active then return end

        if Session.OutlinePlayers then
            task.wait(0.25)

            if Session.Active and Session.OutlinePlayers then
                addPlayerOutline(character)
            end
        end
    end)
end)

connect(Players.PlayerRemoving, function(player)
    if player.Character then
        removePlayerOutline(player.Character)
    end
end)

-- Page Switching

local function setActivePage(page)
    if not Session.Active then return end

    MainPage.Visible = page == MainPage
    TeleporterPage.Visible = page == TeleporterPage
    SaverPage.Visible = page == SaverPage
    PlayerSettingsPage.Visible = page == PlayerSettingsPage
    ExtrasPage.Visible = page == ExtrasPage

    local buttons = {
        {NavMainBtn, MainPage},
        {NavTeleporterBtn, TeleporterPage},
        {NavSaverBtn, SaverPage},
        {NavPlayerSettingsBtn, PlayerSettingsPage},
        {NavExtrasBtn, ExtrasPage}
    }

    for _, data in ipairs(buttons) do
        data[1].BackgroundColor3 =
            data[2] == page
            and Color3.fromRGB(30, 30, 30)
            or Color3.fromRGB(25, 25, 25)

        data[1].TextColor3 =
            data[2] == page
            and Color3.fromRGB(0, 100, 255)
            or Color3.fromRGB(150, 150, 150)
    end
end

connect(NavMainBtn.MouseButton1Click, function()
    setActivePage(MainPage)
end)

connect(NavTeleporterBtn.MouseButton1Click, function()
    setActivePage(TeleporterPage)
end)

connect(NavSaverBtn.MouseButton1Click, function()
    setActivePage(SaverPage)
end)

connect(NavPlayerSettingsBtn.MouseButton1Click, function()
    setActivePage(PlayerSettingsPage)
end)

connect(NavExtrasBtn.MouseButton1Click, function()
    setActivePage(ExtrasPage)
end)

-- Teleporter

local function openPlayerList()
    if not Session.Active then return end

    for _, child in ipairs(PlayerListFrame:GetChildren()) do
        if child:IsA("TextButton") then
            child:Destroy()
        end
    end

    local count = 0

    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= LocalPlayer then
            count += 1

            local button = Instance.new("TextButton")
            button.Parent = PlayerListFrame
            button.BackgroundColor3 = Color3.fromRGB(30, 30, 30)
            button.Size = UDim2.new(1, 0, 0, 25)
            button.Font = Enum.Font.SourceSans
            button.Text =
                player.DisplayName ..
                " (@" ..
                player.Name ..
                ")"
            button.TextColor3 = Color3.fromRGB(255, 255, 255)
            button.TextSize = 12
            button.ZIndex = 6

            connect(button.MouseButton1Click, function()
                InputBox.Text = player.Name
                targetPlayerName = player.Name
                PlayerListFrame.Visible = false
                TPButton.Visible = true
            end)
        end
    end

    PlayerListFrame.CanvasSize =
        UDim2.new(0, 0, 0, count * 25)

    PlayerListFrame.Visible = true
    TPButton.Visible = false
end

connect(InputBox.Focused, openPlayerList)

connect(InputBox.FocusLost, function()
    task.wait(0.2)

    if not Session.Active then return end

    PlayerListFrame.Visible = false
    TPButton.Visible = true
    targetPlayerName = InputBox.Text
end)

local function teleportToPlayer()
    if not Session.Active then return end
    if targetPlayerName == "" then return end

    local target =
        Players:FindFirstChild(targetPlayerName)

    if not target then
        for _, player in ipairs(Players:GetPlayers()) do
            if player.Name:lower() == targetPlayerName:lower()
                or player.DisplayName:lower() == targetPlayerName:lower() then

                target = player
                break
            end
        end
    end

    if not target or not target.Character then return end
    if not LocalPlayer.Character then return end

    local targetRoot =
        target.Character:FindFirstChild("HumanoidRootPart")

    local localRoot =
        LocalPlayer.Character:FindFirstChild("HumanoidRootPart")

    if targetRoot and localRoot then
        localRoot.CFrame = targetRoot.CFrame
    end
end

connect(TPButton.MouseButton1Click, teleportToPlayer)

-- Instance Saver

local updateInstanceList

updateInstanceList = function()
    if not Session.Active then return end

    for _, child in ipairs(InstanceListFrame:GetChildren()) do
        if child:IsA("Frame") then
            child:Destroy()
        end
    end

    CounterLabel.Text =
        "Slots: " ..
        #savedInstances ..
        " / " ..
        maxInstances

    for i, inst in ipairs(savedInstances) do
        if not inst.Part or not inst.Part.Parent then
            continue
        end

        local row = Instance.new("Frame")
        row.Parent = InstanceListFrame
        row.Size = UDim2.new(1, -5, 0, 24)
        row.BackgroundColor3 =
            selectedInstanceIndex == i
            and Color3.fromRGB(0, 40, 120)
            or Color3.fromRGB(25, 25, 25)
        row.BorderSizePixel = 0

        local selectButton = Instance.new("TextButton")
        selectButton.Parent = row
        selectButton.BackgroundTransparency = 1
        selectButton.Size = UDim2.new(0.6, 0, 1, 0)
        selectButton.Font = Enum.Font.Code

        local pos = inst.Part.Position

        selectButton.Text =
            " [" .. i .. "] " ..
            string.format(
                "X:%.0f Y:%.0f Z:%.0f",
                pos.X,
                pos.Y,
                pos.Z
            )

        selectButton.TextColor3 =
            Color3.fromRGB(255, 255, 255)

        selectButton.TextSize = 10
        selectButton.TextXAlignment =
            Enum.TextXAlignment.Left

        connect(selectButton.MouseButton1Click, function()
            selectedInstanceIndex = i
            MoveHandles.Adornee = inst.Part

            InputX.Text = string.format("%.1f", pos.X)
            InputY.Text = string.format("%.1f", pos.Y)
            InputZ.Text = string.format("%.1f", pos.Z)

            updateInstanceList()
        end)

        local keyButton = Instance.new("TextButton")
        keyButton.Parent = row
        keyButton.Position = UDim2.new(0.6, 2, 0, 2)
        keyButton.Size = UDim2.new(0.25, -4, 1, -4)
        keyButton.BackgroundColor3 = Color3.fromRGB(40, 40, 40)
        keyButton.Font = Enum.Font.Code
        keyButton.Text = inst.Key.Name
        keyButton.TextColor3 = Color3.fromRGB(0, 255, 150)
        keyButton.TextSize = 9

        connect(keyButton.MouseButton1Click, function()
            bindingInstanceIndex = i
            listeningForUIBind = false
            listeningForTPBind = false
            keyButton.Text = "..."
        end)

        local deleteButton = Instance.new("TextButton")
        deleteButton.Parent = row
        deleteButton.Position = UDim2.new(0.85, 2, 0, 2)
        deleteButton.Size = UDim2.new(0.15, -4, 1, -4)
        deleteButton.BackgroundColor3 = Color3.fromRGB(150, 0, 0)
        deleteButton.Font = Enum.Font.SourceSansBold
        deleteButton.Text = "X"
        deleteButton.TextColor3 = Color3.fromRGB(255, 255, 255)

        connect(deleteButton.MouseButton1Click, function()
            local part = inst.Part

            if part then
                pcall(function()
                    part:Destroy()
                end)
            end

            if MoveHandles.Adornee == part then
                MoveHandles.Adornee = nil
            end

            table.remove(savedInstances, i)

            if selectedInstanceIndex == i then
                selectedInstanceIndex =
                    #savedInstances > 0 and 1 or nil
            elseif selectedInstanceIndex
                and selectedInstanceIndex > i then

                selectedInstanceIndex -= 1
            end

            updateInstanceList()
        end)
    end

    InstanceListFrame.CanvasSize =
        UDim2.new(0, 0, 0, #savedInstances * 26)
end

connect(AddCubeBtn.MouseButton1Click, function()
    if #savedInstances >= maxInstances then return end
    if not LocalPlayer.Character then return end

    local root =
        LocalPlayer.Character:FindFirstChild("HumanoidRootPart")

    if not root then return end

    local part = Instance.new("Part")
    part.Name = "DenosWareTeleportPart"
    part.Size = Vector3.new(3, 3, 3)
    part.Position = root.Position
    part.Anchored = true
    part.CanCollide = false
    part.Material = Enum.Material.Neon
    part.Color = Color3.fromRGB(0, 70, 255)
    part.Transparency = 0.4
    part.Parent = workspace

    local defaultKeys = {
        Enum.KeyCode.J,
        Enum.KeyCode.L,
        Enum.KeyCode.U,
        Enum.KeyCode.O,
        Enum.KeyCode.P
    }

    table.insert(savedInstances, {
        Part = part,
        Key =
            defaultKeys[#savedInstances + 1]
            or Enum.KeyCode.Unknown
    })

    selectedInstanceIndex = #savedInstances
    MoveHandles.Adornee = part

    updateInstanceList()
end)

local function modifyCoordinates()
    if not selectedInstanceIndex then return end

    local instanceData =
        savedInstances[selectedInstanceIndex]

    if not instanceData or not instanceData.Part then return end

    local part = instanceData.Part

    part.Position = Vector3.new(
        tonumber(InputX.Text) or part.Position.X,
        tonumber(InputY.Text) or part.Position.Y,
        tonumber(InputZ.Text) or part.Position.Z
    )

    updateInstanceList()
end

connect(InputX.FocusLost, modifyCoordinates)
connect(InputY.FocusLost, modifyCoordinates)
connect(InputZ.FocusLost, modifyCoordinates)

local handleStartPosition

connect(MoveHandles.MouseButton1Down, function()
    if MoveHandles.Adornee then
        handleStartPosition =
            MoveHandles.Adornee.Position
    end
end)

connect(MoveHandles.MouseDrag, function(face, distance)
    if not MoveHandles.Adornee then return end
    if not handleStartPosition then return end

    MoveHandles.Adornee.Position =
        handleStartPosition +
        Vector3.FromNormalId(face) * distance

    if selectedInstanceIndex
        and savedInstances[selectedInstanceIndex]
        and savedInstances[selectedInstanceIndex].Part ==
            MoveHandles.Adornee then

        local p = MoveHandles.Adornee.Position

        InputX.Text = string.format("%.1f", p.X)
        InputY.Text = string.format("%.1f", p.Y)
        InputZ.Text = string.format("%.1f", p.Z)
    end
end)

-- Keybinds

connect(UIBindBtn.MouseButton1Click, function()
    listeningForUIBind = true
    listeningForTPBind = false
    bindingInstanceIndex = nil

    UIBindBtn.Text = "UI: [ ... ]"
    UIBindBtn.TextColor3 = Color3.fromRGB(0, 100, 255)
end)

connect(TPBindBtn.MouseButton1Click, function()
    listeningForTPBind = true
    listeningForUIBind = false
    bindingInstanceIndex = nil

    TPBindBtn.Text = "Fast TP: [ ... ]"
    TPBindBtn.TextColor3 = Color3.fromRGB(0, 100, 255)
end)

-- Cleanup

local function restoreCharacter()
    local character = LocalPlayer.Character
    if not character then return end

    -- Restore Weight first.
    restoreOriginalWeight()

    local humanoid =
        character:FindFirstChildOfClass("Humanoid")

    if humanoid then
        pcall(function()
            humanoid.WalkSpeed = DEFAULT_WALKSPEED
            humanoid.UseJumpPower = true
            humanoid.JumpPower = DEFAULT_JUMPPOWER
            humanoid.PlatformStand = false
            humanoid.AutoRotate = true
        end)
    end

    for _, object in ipairs(character:GetDescendants()) do
        if object:IsA("BasePart") then
            pcall(function()
                object.CanCollide = true
            end)
        end

        if object.Name == "DenosWareFlyVelocity"
            or object.Name == "DenosWareFlyGyro" then

            pcall(function()
                object:Destroy()
            end)
        end
    end
end

local function removeDenosObjects()
    for _, inst in ipairs(savedInstances) do
        if inst.Part then
            pcall(function()
                inst.Part:Destroy()
            end)
        end
    end

    table.clear(savedInstances)

    MoveHandles.Adornee = nil

    removeAntiVoidPart()
    removeYAxisLimitPart()
    removeAllPlayerOutlines()
    restoreOriginalWeight()

    local gui =
        PlayerGui:FindFirstChild("Denos_Ware_Panel")

    if gui then
        pcall(function()
            gui:Destroy()
        end)
    end
end

local cleaningUp = false

local function fullyDestroy()
    if cleaningUp then return end

    cleaningUp = true

    if not Session.Active then return end

    Session.Active = false
    Session.Fly = false
    Session.Noclip = false
    Session.AntiVoid = false
    Session.YAxisLimit = false
    Session.OutlinePlayers = false
    Session.WeightEnabled = false

    listeningForUIBind = false
    listeningForTPBind = false
    bindingInstanceIndex = nil

    removeFlyObjects()
    removeAllPlayerOutlines()

    pcall(restoreCharacter)

    pcall(function()
        workspace.Gravity = DEFAULT_GRAVITY
    end)

    pcall(removeDenosObjects)

    disconnectAll()

    if _G.DenosWareSession == Session then
        _G.DenosWareSession = nil
    end

    Session.Cleanup = nil

    print("Denos Ware successfully deactivated")
end

Session.Cleanup = fullyDestroy

connect(CloseButton.MouseButton1Click, fullyDestroy)

-- Minimize

local function setMinimized(state)
    if not Session.Active then return end

    minimized = state

    if panelTween then
        pcall(function()
            panelTween:Cancel()
        end)

        panelTween = nil
    end

    local targetSize =
        minimized
        and collapsedSize
        or expandedSize

    MinimizeButton.Text =
        minimized and "+" or "-"

    panelTween = TweenService:Create(
        MainFrame,
        TweenInfo.new(
            0.25,
            Enum.EasingStyle.Quad,
            Enum.EasingDirection.Out
        ),
        {
            Size = targetSize
        }
    )

    panelTween:Play()
end

connect(MinimizeButton.MouseButton1Click, function()
    setMinimized(not minimized)
end)

-- Keyboard Input

connect(UserInputService.InputBegan, function(input, gameProcessed)
    if not Session.Active then return end

    if listeningForUIBind
        or listeningForTPBind
        or bindingInstanceIndex then

        if input.UserInputType ==
            Enum.UserInputType.Keyboard then

            if listeningForUIBind then
                panelToggleKey = input.KeyCode

                savedSettings.PanelToggleKey =
                    panelToggleKey.Name

                saveSettings()

                UIBindBtn.Text =
                    "UI: [ " ..
                    panelToggleKey.Name ..
                    " ]"

                UIBindBtn.TextColor3 =
                    Color3.fromRGB(120, 120, 120)

                listeningForUIBind = false

            elseif listeningForTPBind then
                instantTPKey = input.KeyCode

                savedSettings.InstantTPKey =
                    instantTPKey.Name

                saveSettings()

                TPBindBtn.Text =
                    "Fast TP: [ " ..
                    instantTPKey.Name ..
                    " ]"

                TPBindBtn.TextColor3 =
                    Color3.fromRGB(120, 120, 120)

                listeningForTPBind = false

            elseif bindingInstanceIndex
                and savedInstances[bindingInstanceIndex] then

                savedInstances[bindingInstanceIndex].Key =
                    input.KeyCode

                bindingInstanceIndex = nil

                updateInstanceList()
            end
        end

        return
    end

    if gameProcessed then return end

    if panelToggleKey
        and input.KeyCode == panelToggleKey then

        MainFrame.Visible = not MainFrame.Visible
    end

    if instantTPKey
        and input.KeyCode == instantTPKey then

        teleportToPlayer()
    end

    for _, inst in ipairs(savedInstances) do
        if inst.Key and input.KeyCode == inst.Key then

            if LocalPlayer.Character
                and inst.Part
                and inst.Part.Parent then

                local root =
                    LocalPlayer.Character:FindFirstChild(
                        "HumanoidRootPart"
                    )

                if root then
                    root.CFrame =
                        CFrame.new(
                            inst.Part.Position +
                            Vector3.new(0, 3, 0)
                        )
                end
            end

            break
        end
    end
end)

-- Initial State

setActivePage(MainPage)

updateToggleIndicator(FlyIndicator, false)
updateToggleIndicator(NoclipIndicator, false)
updateToggleIndicator(AntiVoidIndicator, false)
updateToggleIndicator(YAxisLimitIndicator, false)
updateToggleIndicator(OutlinePlayersIndicator, false)

updateYAxisLimitDisplay()

applyStats()

print("Denos Ware successfully loaded")
