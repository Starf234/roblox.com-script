local function getPing()
    local success, value = pcall(function()
        local networkStats = Stats:FindFirstChild("Network")
        local serverStats = networkStats
            and networkStats:FindFirstChild("ServerStatsItem")

        if serverStats then
            local pingItem = serverStats:FindFirstChild("Data Ping")

            if pingItem then
                local valueString = pingItem:GetValueString()
                local number =
                    tonumber(string.match(valueString, "[%d%.]+"))

                if number then
                    return number
                end
            end
        end

        return 0
    end)

    return success and value or 0
end

local lastFPS = 0
local fpsFrames = 0
local fpsTime = 0

connect(RunService.RenderStepped, function(deltaTime)
    fpsFrames += 1
    fpsTime += deltaTime

    if fpsTime >= 0.5 then
        lastFPS = math.floor(fpsFrames / fpsTime)
        fpsFrames = 0
        fpsTime = 0
    end
end)

local function updateMainInfo()
    if not Session.Active then return end

    local gameName = "Unknown Game"

    pcall(function()
        gameName = MarketplaceService:GetProductInfo(game.PlaceId).Name
    end)

    PlayerInfoLabel.Text =
        "PLAYER INFO\n\n" ..
        "Username: " .. LocalPlayer.Name .. "\n" ..
        "Display Name: " .. LocalPlayer.DisplayName .. "\n" ..
        "User ID: " .. tostring(LocalPlayer.UserId) .. "\n" ..
        "Ping: " .. tostring(math.floor(getPing())) .. " ms\n" ..
        "FPS: " .. tostring(lastFPS) .. " FPS"

    SessionInfoLabel.Text =
        "Game: " .. gameName .. "\n" ..
        "Place ID: " .. tostring(game.PlaceId) .. "\n" ..
        "Job ID: " .. tostring(game.JobId)
end

task.spawn(function()
    while Session.Active do
        updateMainInfo()
        task.wait(1)
    end
end)

