local function applyStyle(color)
	accent = color

	local panelDark = color:Lerp(Color3.fromRGB(15, 17, 21), 0.78)
	local panelSurface = color:Lerp(Color3.fromRGB(25, 27, 31), 0.62)
	local buttonShade = color:Lerp(Color3.fromRGB(25, 27, 31), 0.38)
	local headerShade = color:Lerp(Color3.fromRGB(25, 27, 31), 0.55)
	local messageShade = color:Lerp(Color3.fromRGB(25, 27, 31), 0.68)

	styleButton.BackgroundColor3 = color
	frameStroke.Color = color
	inputStroke.Color = color
	header.BackgroundColor3 = headerShade
	inputContainer.BackgroundColor3 = panelDark
	closeButton.BackgroundColor3 = buttonShade
	closeStyle.BackgroundColor3 = buttonShade
	applyHexButton.BackgroundColor3 = color
	resetStyleButton.BackgroundColor3 = buttonShade
	hexInput.BackgroundColor3 = panelDark
	emojiSearch.BackgroundColor3 = panelDark
	emojiPanel.BackgroundColor3 = panelSurface
	messages.ScrollBarImageColor3 = color

	for _, child in ipairs(header:GetChildren()) do
		if child:IsA("Frame") then
			child.BackgroundColor3 = headerShade
		end
	end

	for _, child in ipairs(messages:GetChildren()) do
		if child:IsA("TextLabel") and child.Name:match("^Message_") then
			child.BackgroundColor3 = messageShade
		end
	end

	local timestampColor = color:Lerp(Color3.fromRGB(220, 220, 230), 0.42)
	local timestampHex = toHex(timestampColor)

	for _, child in ipairs(messages:GetChildren()) do
		if child:IsA("TextLabel") and child.Name:match("^Message_") then
			child:SetAttribute("TimestampHex", timestampHex)
		end
	end
end

