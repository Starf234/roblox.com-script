local function createInputBox()
	local box = make("TextBox", {
		Name = "ChatInput",
		Position = UDim2.fromOffset(11, 0),
		Size = UDim2.new(1, -22, 1, 0),
		BackgroundTransparency = 1,
		ClearTextOnFocus = false,
		MultiLine = false,
		Font = Enum.Font.SourceSans,
		TextSize = 18,
		TextColor3 = WHITE,
		PlaceholderColor3 = MUTED,
		PlaceholderText = INPUT_PLACEHOLDER,
		Text = "",
		TextXAlignment = Enum.TextXAlignment.Left,
		TextYAlignment = Enum.TextYAlignment.Center,
		ZIndex = 11
	}, inputContainer)

	track(box:GetPropertyChangedSignal("Text"):Connect(function()
		if box ~= input or handlingEmojiTrigger then return end

		local startPos, endPos = box.Text:find(":emojis:", 1, true)
		if not startPos then return end

		savedCursorPosition = startPos
		local newText = box.Text:sub(1, startPos - 1)
			.. box.Text:sub(endPos + 1)

		handlingEmojiTrigger = true
		box.Text = newText
		box.CursorPosition = startPos
		handlingEmojiTrigger = false

		if openEmojiPicker then openEmojiPicker() end
	end))

	track(box.FocusLost:Connect(function(enterPressed)
		if box ~= input or not enterPressed then return end
		task.defer(function()
			if not closed and box == input and sendMessage then
				sendMessage()
			end
		end)
	end))

	return box
end

