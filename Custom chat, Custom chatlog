	CellPadding = UDim2.fromOffset(2, 2),
	SortOrder = Enum.SortOrder.LayoutOrder
}, emojiScroll)

local function rebuildEmojiList(searchText)
	for _, child in ipairs(emojiScroll:GetChildren()) do
		if child:IsA("TextButton") then
			child:Destroy()
		end
	end

	searchText = string.lower(searchText or "")
	local order = 0

	for category, contents in pairs(CATALOG) do
		local categoryMatches = searchText == ""
			or string.find(string.lower(category), searchText, 1, true) ~= nil

		for emoji in contents:gmatch("%S+") do
			if categoryMatches or string.find(emoji, searchText, 1, true) then
				order += 1

				local button = make("TextButton", {
					LayoutOrder = order,
					BackgroundColor3 = Color3.fromRGB(48, 51, 62),
					BorderSizePixel = 0,
					Text = emoji,
					TextSize = 20,
					Font = Enum.Font.SourceSans,
					ZIndex = 22
				}, emojiScroll)
				corner(button, 4)

				track(button.Activated:Connect(function()
					if closed or not input or not input.Parent then return end

					local text = input.Text
					local cursor = savedCursorPosition
					if cursor < 1 or cursor > #text + 1 then
						cursor = #text + 1
					end

					input.Text = text:sub(1, cursor - 1)
						.. emoji .. text:sub(cursor)
					savedCursorPosition = cursor + #emoji
					emojiPanel.Visible = false
					input:CaptureFocus()
					input.CursorPosition = savedCursorPosition
				end))
			end
		end
	end
end

openEmojiPicker = function()
	if not input then return end

	savedCursorPosition = input.CursorPosition
	if savedCursorPosition < 1 then
		savedCursorPosition = #input.Text + 1
	end

	emojiPanel.Visible = true
	emojiSearch.Text = ""
	rebuildEmojiList("")
	emojiSearch:CaptureFocus()
end

track(emojiSearch:GetPropertyChangedSignal("Text"):Connect(function()
	rebuildEmojiList(emojiSearch.Text)
end))

local messageCount = 0
local seenMessages = setmetatable({}, {__mode = "k"})

local function addMessage(displayName, messageText, messageObject, formatted)
	if closed then return end

	if messageObject then
		if seenMessages[messageObject] then return end
		seenMessages[messageObject] = true
	end

	messageCount += 1

	local timestampColor = accent:Lerp(Color3.fromRGB(220, 220, 230), 0.42)
	local timestampHex = toHex(timestampColor)
	local rowColor = accent:Lerp(Color3.fromRGB(25, 27, 31), 0.68)

	local row = make("TextLabel", {
		Name = "Message_" .. messageCount,
		LayoutOrder = messageCount,
		Size = UDim2.new(1, -5, 0, 0),
		AutomaticSize = Enum.AutomaticSize.Y,
		BackgroundColor3 = rowColor,
		BackgroundTransparency = 0.72,
		BorderSizePixel = 0,
		Font = Enum.Font.SourceSans,
		TextSize = 18,
		TextWrapped = true,
		TextXAlignment = Enum.TextXAlignment.Left,
		TextYAlignment = Enum.TextYAlignment.Top,
		TextColor3 = WHITE,
		RichText = true
	}, messages)

	row:SetAttribute("TimestampHex", timestampHex)

	if formatted then
		row.Text = string.format(
			'<font color="%s">[%s]</font> %s %s',
			timestampHex,
			escapeRichText(os.date("%H:%M:%S")),
			displayName or "",
			escapeRichText(messageText or "")
		)
	else
		row.Text = string.format(
			'<font color="%s">[%s]</font> <font color="#D4D4D4">%s:</font> %s',
			timestampHex,
			escapeRichText(os.date("%H:%M:%S")),
			escapeRichText(displayName or "System"),
			escapeRichText(messageText or "")
		)
	end

	local rows = {}
	for _, child in ipairs(messages:GetChildren()) do
		if child:IsA("TextLabel") and child.Name:match("^Message_%d+$") then
			table.insert(rows, child)
		end
	end

	table.sort(rows, function(a, b)
		return a.LayoutOrder < b.LayoutOrder
	end)

	while #rows > MAX_MESSAGES do
		rows[1]:Destroy()
		table.remove(rows, 1)
	end

	countLabel.Text = tostring(math.min(messageCount, MAX_MESSAGES))

	task.defer(function()
		if not closed and messages.Parent then
			messages.CanvasPosition = Vector2.new(
				0,
				math.max(0, messages.AbsoluteCanvasSize.Y - messages.AbsoluteWindowSize.Y)
			)
		end
	end)
end

local function refreshMessageStyles()
	local timestampHex = toHex(accent:Lerp(Color3.fromRGB(220, 220, 230), 0.42))
	local rowColor = accent:Lerp(Color3.fromRGB(25, 27, 31), 0.68)

	for _, row in ipairs(messages:GetChildren()) do
		if row:IsA("TextLabel") and row.Name:match("^Message_%d+$") then
			row.BackgroundColor3 = rowColor
			row:SetAttribute("TimestampHex", timestampHex)

			local oldText = row.Text
			local prefix, rest = oldText:match("^(.-%[.-%])(.*)$")

			if prefix and rest then
				local escapedPrefix = prefix:gsub(
					'<font color=".-">',
					'<font color="' .. timestampHex .. '">'
				)
				row.Text = escapedPrefix .. rest
			end
		end
	end
end

local originalApplyStyle = applyStyle
applyStyle = function(color)
	originalApplyStyle(color)
	refreshMessageStyles()
end

track(TextChatService.MessageReceived:Connect(function(message)
	if not message or not message.Text or message.Text == "" then return end

	local prefix = message.PrefixText or ""
	if prefix == "" and message.TextSource then
		local sender = Players:GetPlayerByUserId(message.TextSource.UserId)
		prefix = escapeRichText(sender and sender.DisplayName or "Player") .. ":"
	end

	addMessage(prefix, message.Text, message, true)
end))

local function getChannel()
	local channels = TextChatService:FindFirstChild("TextChannels")
	if not channels then return nil end

	local general = channels:FindFirstChild("RBXGeneral")
	if general and general:IsA("TextChannel") then
		return general
	end

	for _, channel in ipairs(channels:GetChildren()) do
		if channel:IsA("TextChannel") then
			return channel
		end
	end

	return nil
end

local function refreshChatBar()
	local oldInput = input
	if oldInput then oldInput:Destroy() end

	handlingEmojiTrigger = false
	savedCursorPosition = 1
	input = createInputBox()
	emojiPanel.Visible = false

	task.defer(function()
		if not closed and gui.Parent and input and input.Parent then
			input:CaptureFocus()
			input.CursorPosition = 1
		end
	end)
end

sendMessage = function()
	if closed or sending or not input or not input.Parent then return end

	local text = input.Text
	if text:gsub("%s+", "") == "" then return end

	local channel = getChannel()
	if not channel then
		addMessage("System", "No chat channel is available.")
		return
	end

	sending = true
	refreshChatBar()

	task.spawn(function()
		local ok, err = pcall(function()
			channel:SendAsync(text)
		end)

		if not ok then
			warn("[CustomChat] SendAsync failed:", err)
		end

		sending = false
	end)
end

local dragging = false
local resizing = false
local dragStart
local dragStartPosition
local resizeStart
local resizeStartSize
local resizeStartPosition
local activeCorner
local CORNER_SIZE = 24

track(header.InputBegan:Connect(function(obj)
	if obj.UserInputType == Enum.UserInputType.MouseButton1
		or obj.UserInputType == Enum.UserInputType.Touch then

		local pointer = obj.Position
		local closePos = closeButton.AbsolutePosition
		local closeSize = closeButton.AbsoluteSize

		if pointer.X >= closePos.X
			and pointer.X <= closePos.X + closeSize.X
			and pointer.Y >= closePos.Y
			and pointer.Y <= closePos.Y + closeSize.Y then
			return
		end

		dragging = true
		resizing = false
		dragStart = obj.Position
		dragStartPosition = frame.Position
	end
end))

for _, name in ipairs({"TopLeft", "TopRight", "BottomLeft", "BottomRight"}) do
	local area = make("TextButton", {
		Name = name .. "ResizeArea",
		Size = UDim2.fromOffset(CORNER_SIZE, CORNER_SIZE),
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		Text = "",
		AutoButtonColor = false,
		Active = true,
		ZIndex = 30
	}, frame)

	if name == "TopLeft" then
		area.Position = UDim2.fromOffset(0, 0)
	elseif name == "TopRight" then
		area.AnchorPoint = Vector2.new(1, 0)
		area.Position = UDim2.new(1, -30, 0, 0)
	elseif name == "BottomLeft" then
		area.AnchorPoint = Vector2.new(0, 1)
		area.Position = UDim2.new(0, 0, 1, 0)
	else
		area.AnchorPoint = Vector2.new(1, 1)
		area.Position = UDim2.new(1, 0, 1, 0)
	end

	track(area.InputBegan:Connect(function(obj)
		if obj.UserInputType ~= Enum.UserInputType.MouseButton1
			and obj.UserInputType ~= Enum.UserInputType.Touch then
			return
		end

		if name == "TopRight" then
			local pointer = obj.Position
			local closePos = closeButton.AbsolutePosition
			local closeSize = closeButton.AbsoluteSize

			if pointer.X >= closePos.X
				and pointer.X <= closePos.X + closeSize.X
				and pointer.Y >= closePos.Y
				and pointer.Y <= closePos.Y + closeSize.Y then
				return
			end
		end

		resizing = true
		dragging = false
		activeCorner = name
		resizeStart = obj.Position
		resizeStartSize = frame.AbsoluteSize
		resizeStartPosition = frame.Position
	end))
end

track(UserInputService.InputChanged:Connect(function(obj)
	if closed then return end
	if obj.UserInputType ~= Enum.UserInputType.MouseMovement
		and obj.UserInputType ~= Enum.UserInputType.Touch then
		return
	end

	if dragging then
		local delta = obj.Position - dragStart
		frame.Position = UDim2.new(
			dragStartPosition.X.Scale,
			dragStartPosition.X.Offset + delta.X,
			dragStartPosition.Y.Scale,
			dragStartPosition.Y.Offset + delta.Y
		)
	end

	if resizing then
		local delta = obj.Position - resizeStart
		local left = activeCorner == "TopLeft" or activeCorner == "BottomLeft"
		local top = activeCorner == "TopLeft" or activeCorner == "TopRight"

		local width = resizeStartSize.X + (left and -delta.X or delta.X)
		local height = resizeStartSize.Y + (top and -delta.Y or delta.Y)

		local newWidth = math.clamp(width, MIN_WIDTH, MAX_WIDTH)
		local newHeight = math.clamp(height, MIN_HEIGHT, MAX_HEIGHT)

		local x = resizeStartPosition.X.Offset
		local y = resizeStartPosition.Y.Offset

		if left then x += resizeStartSize.X - newWidth end
		if top then y += resizeStartSize.Y - newHeight end

		frame.Size = UDim2.fromOffset(newWidth, newHeight)
		frame.Position = UDim2.new(
			resizeStartPosition.X.Scale, x,
			resizeStartPosition.Y.Scale, y
		)
	end
end))

track(UserInputService.InputEnded:Connect(function(obj)
	if obj.UserInputType == Enum.UserInputType.MouseButton1
		or obj.UserInputType == Enum.UserInputType.Touch then
		dragging = false
		resizing = false
		activeCorner = nil
	end
end))

local function restoreBuiltInChat()
	pcall(function()
		TextChatService.ChatWindowConfiguration.Enabled = true
	end)

	pcall(function()
		TextChatService.ChatInputBarConfiguration.Enabled = true
	end)

	pcall(function()
		StarterGui:SetCoreGuiEnabled(Enum.CoreGuiType.Chat, true)
	end)

	task.defer(function()
		pcall(function()
			TextChatService.ChatWindowConfiguration.Enabled = true
			TextChatService.ChatInputBarConfiguration.Enabled = true
			StarterGui:SetCoreGuiEnabled(Enum.CoreGuiType.Chat, true)
		end)
	end)
end

local function closeCustomChat()
	if closed then return end
	closed = true

	dragging = false
	resizing = false
	activeCorner = nil

	restoreBuiltInChat()

	for _, connection in ipairs(connections) do
		pcall(function()
			connection:Disconnect()
		end)
	end
	table.clear(connections)

	gui:Destroy()
end

track(closeButton.Activated:Connect(closeCustomChat))

track(UserInputService.InputBegan:Connect(function(key, processed)
	if closed or processed or key.KeyCode ~= Enum.KeyCode.Slash then return end
	if UserInputService:GetFocusedTextBox() then return end

	if input and input.Parent then
		input:CaptureFocus()
		task.defer(function()
			if not closed and input and input.Parent and input:IsFocused() then
				input.CursorPosition = #input.Text + 1
			end
		end)
	end
end))

pcall(function()
	TextChatService.ChatWindowConfiguration.Enabled = false
	TextChatService.ChatInputBarConfiguration.Enabled = false
	StarterGui:SetCoreGuiEnabled(Enum.CoreGuiType.Chat, false)
end)

applyStyle(accent)
